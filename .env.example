# Environment ('development', 'staging', 'production', 'test')
NODE_ENV=development

# Server
PORT=3000

# Database (use port 5433 if connecting to the docker-compose postgres service)
DATABASE_URL=postgresql://infurnus:infurnus_dev@localhost:5433/infurnus

# CORS (comma-separated origins allowed in production)
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# JWT
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
# JWT_ACCESS_PREVIOUS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Refresh-token cookie
AUTH_REFRESH_COOKIE_NAME=infurnus_refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=strict

# CSRF cookie
AUTH_CSRF_COOKIE_NAME=infurnus_csrf_token
AUTH_CSRF_COOKIE_SECURE=false
AUTH_CSRF_COOKIE_SAME_SITE=strict

# Authentication rate limits
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10

AUTH_SIGNUP_RATE_LIMIT_WINDOW_MS=900000
AUTH_SIGNUP_RATE_LIMIT_MAX=5

AUTH_OTP_VERIFY_RATE_LIMIT_WINDOW_MS=600000
AUTH_OTP_VERIFY_RATE_LIMIT_MAX=10

AUTH_OTP_RESEND_RATE_LIMIT_WINDOW_MS=600000
AUTH_OTP_RESEND_RATE_LIMIT_MAX=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60

AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REFRESH_RATE_LIMIT_MAX=30

AUTH_LOGOUT_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGOUT_RATE_LIMIT_MAX=30

# Disable rate limiting for development/testing
AUTH_RATE_LIMIT_ENABLED=false

# Driver matching / location
DRIVER_LOCATION_STALE_SECONDS=30
DRIVER_SEARCH_RADIUS_METERS=5000
MAX_DRIVER_MATCH_CANDIDATES=20

# Google Maps
# GOOGLE_MAPS_API_KEY=
GOOGLE_REQUEST_TIMEOUT_MS=5000
GOOGLE_MAX_RETRIES=2
GOOGLE_PLACES_MIN_QUERY_LENGTH=3
GOOGLE_PLACES_MIN_INTERVAL_MS=300
GOOGLE_ROUTE_RECALCULATION_INTERVAL_SECONDS=30
GOOGLE_ROUTE_RECALCULATION_DISTANCE_METERS=500

# Sendmator SMS OTP (optional; falls back to DevOtpProvider when empty)
# SENDMATOR_API_KEY=

# Authentication Challenge Encryption (REQUIRED: base64-encoded 32-byte key)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
AUTH_OTP_ENCRYPTION_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=

# Resend Email Delivery (optional)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Cashfree Payment Gateway ('sandbox' or 'production')
CASHFREE_ENV=sandbox
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg

# Cashfree Payouts (for driver & fleet owner payouts)
# CASHFREE_PAYOUT_CLIENT_ID=
# CASHFREE_PAYOUT_CLIENT_SECRET=

# ============================================================
# Redis
# ============================================================

REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT:YOUR_PORT
REDIS_MAX_RETRIES=3
REDIS_CONNECT_TIMEOUT_MS=10000

# ============================================================
# Notifications
# ============================================================

NOTIFICATION_QUEUE_NAME=infurnus-notifications
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BACKOFF_DELAY_MS=5000

# ============================================================
# Firebase / FCM
# ============================================================

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"