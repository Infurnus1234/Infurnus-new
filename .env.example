# Server
PORT=3000

# Database
DATABASE_URL=postgresql://infurnus:<password>@localhost:5432/infurnus

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# JWT
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_PREVIOUS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Refresh-token cookie
AUTH_REFRESH_COOKIE_NAME=infurnus_refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=strict

# CSRF cookie
AUTH_CSRF_COOKIE_NAME=infurnus_csrf_token
AUTH_CSRF_COOKIE_SECURE=false
AUTH_CSRF_COOKIE_SAME_SITE=strict

# Authentication rate limits
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10

AUTH_SIGNUP_RATE_LIMIT_WINDOW_MS=900000
AUTH_SIGNUP_RATE_LIMIT_MAX=5

AUTH_OTP_VERIFY_RATE_LIMIT_WINDOW_MS=600000
AUTH_OTP_VERIFY_RATE_LIMIT_MAX=10

AUTH_OTP_RESEND_RATE_LIMIT_WINDOW_MS=600000
AUTH_OTP_RESEND_RATE_LIMIT_MAX=5

AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REFRESH_RATE_LIMIT_MAX=30

AUTH_LOGOUT_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGOUT_RATE_LIMIT_MAX=30

# Driver matching / location
DRIVER_LOCATION_STALE_SECONDS=30
DRIVER_SEARCH_RADIUS_METERS=5000
MAX_DRIVER_MATCH_CANDIDATES=20

# Google Maps
GOOGLE_MAPS_API_KEY=
GOOGLE_REQUEST_TIMEOUT_MS=5000
GOOGLE_MAX_RETRIES=2
GOOGLE_PLACES_MIN_QUERY_LENGTH=3
GOOGLE_PLACES_MIN_INTERVAL_MS=300
GOOGLE_ROUTE_RECALCULATION_INTERVAL_SECONDS=30
GOOGLE_ROUTE_RECALCULATION_DISTANCE_METERS=500
